@model ClientManagement.Domain.Client
@{ ViewData["Title"] = Model.Id == 0 ? "New client" : "Edit client"; var addresses = Model.Addresses.Concat(Enumerable.Repeat(new ClientManagement.Domain.Address(), Math.Max(0, 3 - Model.Addresses.Count))).ToList(); var contacts = Model.Contacts.Concat(Enumerable.Repeat(new ClientManagement.Domain.Contact(), Math.Max(0, 3 - Model.Contacts.Count))).ToList(); }
<header class="toolbar"><div><p class="eyebrow">CLIENT RECORD</p><h1>@ViewData["Title"]</h1></div><a class="text-link" asp-action="Index">Back to directory</a></header>
<form method="post" class="editor"><input type="hidden" asp-for="Id" /><section><h2>Basic details</h2><div class="grid"><label>First name<input asp-for="FirstName" required /></label><label>Last name<input asp-for="LastName" required /></label><label>Gender<select asp-for="Gender" required><option value="">Choose...</option><option>Female</option><option>Male</option><option>Non-binary</option><option>Prefer not to say</option></select></label><label>Date of birth<input asp-for="DateOfBirth" type="date" /></label><label>Identity number<input asp-for="IdentityNumber" /></label></div><label>Notes<textarea asp-for="Notes" rows="3"></textarea></label></section><section><h2>Addresses</h2>@for (var i = 0; i < addresses.Count; i++) { <div class="repeat-row"><input name="Addresses[@i].Type" value="@addresses[i].Type" placeholder="Residential Address" /><input name="Addresses[@i].Line1" value="@addresses[i].Line1" placeholder="Street address" /><input name="Addresses[@i].City" value="@addresses[i].City" placeholder="City" /><input name="Addresses[@i].PostalCode" value="@addresses[i].PostalCode" placeholder="Postal code" /></div> }</section><section><h2>Contact information</h2>@for (var i = 0; i < contacts.Count; i++) { <div class="repeat-row"><input name="Contacts[@i].Type" value="@contacts[i].Type" placeholder="Cell Number" /><input name="Contacts[@i].Value" value="@contacts[i].Value" placeholder="Contact value" /></div> }</section><button type="submit">Save client</button></form>
@model ClientManagement.Web.Controllers.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<main class="login-panel"><p class="eyebrow">CLIENT RECORDS</p><h1>Sign in</h1><form method="post"><input type="hidden" asp-for="ReturnUrl" /><label asp-for="Username">Username</label><input asp-for="Username" autocomplete="username" required /><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="current-password" required /><button type="submit">Continue</button></form><p class="hint">Default local account: admin / admin123</p></main>